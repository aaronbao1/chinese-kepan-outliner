{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "chinese-workflow/pipeline/schemas/chunks.schema.json",
 "title": "outlined-and-chunked-text = interlinear outline (chunks/1)",
 "description": "The interlinear outline of the Tibetan workflow (docs/outliner-design.md, \"Output formats\") with CBETA locators in place of folios (docs/outliner-design.md §7). chunks.md is rendered from this file and parses back to it.",
 "type": "object",
 "required": ["schema", "metadata", "markers", "announcements", "chunks"],
 "additionalProperties": false,
 "properties": {
  "schema": {"const": "chunks/1"},
  "metadata": {"type": "object",
   "required": ["target", "target_role", "outline_ref", "sentence_rule", "size_budget", "counts"],
   "properties": {
    "target": {"type": "object", "required": ["text_id", "sha256"]},
    "target_role": {"enum": ["root", "commentary"]},
    "outline_ref": {"type": "object", "required": ["path", "sha256"]},
    "sentence_rule": {"type": "string"},
    "size_budget": {"type": "object", "required": ["sentence_cap", "chars"],
     "properties": {"sentence_cap": {"type": "integer", "minimum": 1}, "chars": {"type": ["integer", "null"], "minimum": 1}}},
    "counts": {"type": "object"}}},
  "markers": {"type": "array", "items": {"type": "object",
   "required": ["node_id", "indicator", "heading", "locator", "before_chunk"],
   "additionalProperties": false,
   "properties": {"node_id": {"type": "string"}, "indicator": {"type": "string"}, "heading": {"type": "string"},
    "locator": {"type": ["string", "null"], "description": "commentary.announced when announced, else commentary.explained (Kurt's marker carries the first-appears folio); for a root target without commentary lines, root_text.start"},
    "before_chunk": {"type": "string"}}}},
  "announcements": {"type": "array", "items": {"type": "object",
   "required": ["node_id", "indicator", "heading", "after_chunk", "parent_id"],
   "additionalProperties": false,
   "properties": {"node_id": {"type": "string"}, "indicator": {"type": "string"}, "heading": {"type": "string"},
    "after_chunk": {"type": "string"}, "parent_id": {"type": ["string", "null"]}}}},
  "chunks": {"type": "array", "items": {"type": "object",
   "required": ["chunk_id", "node_id", "leaf_ids", "outline_path", "topic_category", "loc_start", "loc_end",
                "char_start", "char_end", "sentence_ids", "n_sentences", "n_chars", "fallback", "text"],
   "additionalProperties": false,
   "properties": {
    "chunk_id": {"type": "string", "pattern": "^c[0-9]+$"},
    "node_id": {"type": ["string", "null"], "description": "smallest outline node covering the chunk (the context key); null for an unoutlined window"},
    "leaf_ids": {"type": "array", "items": {"type": "string"}, "description": "outlined-text spans (leaf or preamble node ids) the chunk unions"},
    "outline_path": {"type": "array", "items": {"type": "string"}, "description": "node ids from the root to node_id"},
    "topic_category": {"type": ["string", "null"]},
    "loc_start": {"type": "string", "description": "CBETA linehead (+ ':offset') of the first character"},
    "loc_end": {"type": "string", "description": "CBETA linehead (+ ':offset') of the last character"},
    "char_start": {"type": "integer"}, "char_end": {"type": "integer"},
    "sentence_ids": {"type": "array", "items": {"type": "string"}},
    "n_sentences": {"type": "integer"}, "n_chars": {"type": "integer"},
    "fallback": {"enum": ["none", "unoutlined", "split-leaf"]},
    "text": {"type": "string"}}}}
 }
}
